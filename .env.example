# The bot under test and the judge use models from DIFFERENT vendors (OpenAI gpt-oss vs Alibaba Qwen).
# Any OpenAI-compatible endpoint works. Free tiers are enough: bot on Ollama Cloud, judge on Groq.
BOT_BASE_URL=https://ollama.com/v1
BOT_API_KEY=
BOT_MODEL=gpt-oss:120b
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=
JUDGE_MODEL=qwen/qwen3.8-27b
# THIRDUMPIRE_OFFLINE=1   # replay recorded runs only, no AI calls
# SLACK_BOT_TOKEN=xoxb-...   # optional: lets switch/setup.py invite people to the channel
