# The bot under test and the judge use models from DIFFERENT vendors (OpenAI gpt-oss vs Alibaba Qwen), both on Groq's free tier.
# Any OpenAI-compatible endpoint works. Free tiers are enough.
BOT_BASE_URL=https://api.groq.com/openai/v1
BOT_API_KEY=
BOT_MODEL=openai/gpt-oss-120b
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_API_KEY=
JUDGE_MODEL=qwen/qwen3.8-27b
# THIRDUMPIRE_OFFLINE=1   # replay recorded runs only, no AI calls
